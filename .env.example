# TamozaLogger — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
DB_DSN=postgresql://tamoza:password@localhost:5432/tamoza_logger

# ── Optional ────────────────────────────────────────────────────────────────
# Default command prefix (fallback for non-slash usage)
DEFAULT_PREFIX=!

# Discord application/client ID (for invite links)
APPLICATION_ID=0

# During development, sync slash commands to a single guild instantly.
# Comment out or leave empty to sync globally (takes ~1 hour).
# DEV_GUILD_ID=123456789012345678

# Audit log propagation delay in seconds (default: 0.75)
# AUDIT_LOG_DELAY=0.75

# Audit log recency window in seconds (default: 5.0)
# AUDIT_LOG_WINDOW=5.0

# Number of audit log entries to fetch per query (default: 5)
# AUDIT_LOG_LIMIT=5

# Max messages to include in a bulk-delete HTML transcript (default: 1000)
# TRANSCRIPT_MAX_MESSAGES=1000
